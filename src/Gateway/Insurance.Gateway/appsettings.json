{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "InsuranceApi",
    "Audience": "InsuranceApp"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:4200"
    ]
  },
  "Services": {
    "Identity": "http://localhost:5101/",
    "Enrollments": "http://localhost:5104/",
    "Claims": "http://localhost:5106/"
  },
  "ReverseProxy": {
    "Routes": {
      "auth": {
        "ClusterId": "identity",
        "Match": {
          "Path": "/api/auth/{**rest}"
        }
      },
      "policies": {
        "ClusterId": "catalog",
        "Match": {
          "Path": "/api/policies/{**rest}"
        }
      },
      "quotes": {
        "ClusterId": "quotes",
        "Match": {
          "Path": "/api/quotes/{**rest}"
        }
      },
      "payments-schedule": {
        "ClusterId": "billing",
        "Match": {
          "Path": "/api/enrollments/{id}/payments"
        },
        "Order": -1
      },
      "payments": {
        "ClusterId": "billing",
        "Match": {
          "Path": "/api/payments/{**rest}"
        }
      },
      "payment-methods": {
        "ClusterId": "billing",
        "Match": {
          "Path": "/api/payment-methods/{**rest}"
        }
      },
      "enrollments": {
        "ClusterId": "enrollments",
        "Match": {
          "Path": "/api/enrollments/{**rest}"
        }
      },
      "claims": {
        "ClusterId": "claims",
        "Match": {
          "Path": "/api/claims/{**rest}"
        }
      }
    },
    "Clusters": {
      "identity": {
        "Destinations": {
          "d1": {
            "Address": "http://localhost:5101/"
          }
        }
      },
      "catalog": {
        "Destinations": {
          "d1": {
            "Address": "http://localhost:5102/"
          }
        }
      },
      "quotes": {
        "Destinations": {
          "d1": {
            "Address": "http://localhost:5103/"
          }
        }
      },
      "enrollments": {
        "Destinations": {
          "d1": {
            "Address": "http://localhost:5104/"
          }
        }
      },
      "billing": {
        "Destinations": {
          "d1": {
            "Address": "http://localhost:5105/"
          }
        }
      },
      "claims": {
        "Destinations": {
          "d1": {
            "Address": "http://localhost:5106/"
          }
        }
      }
    }
  }
}
