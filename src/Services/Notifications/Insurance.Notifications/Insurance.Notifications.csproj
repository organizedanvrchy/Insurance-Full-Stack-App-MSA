<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- The Notifications microservice: its own process, its own database (InsuranceNotifications).
       Listens to the other services' events and emails customers about them; owns their email preferences.
       It may reference BuildingBlocks and other services' *.Contracts projects, never their implementation.
       Nothing calls it except the browser (preferences), so it has no Contracts project of its own. -->

  <PropertyGroup>
    <UserSecretsId>insurance-notifications-service</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- Run by DatabaseMigrator at startup. -->
    <EmbeddedResource Include="Database\*.sql" />
  </ItemGroup>

  <ItemGroup>
    <!-- SMTP client (the .NET counterpart of Python's smtplib; Microsoft recommends it over System.Net.Mail). -->
    <PackageReference Include="MailKit" Version="4.18.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\BuildingBlocks\Insurance.BuildingBlocks\Insurance.BuildingBlocks.csproj" />
    <ProjectReference Include="..\..\Identity\Insurance.Identity.Contracts\Insurance.Identity.Contracts.csproj" />
    <ProjectReference Include="..\..\Catalog\Insurance.Catalog.Contracts\Insurance.Catalog.Contracts.csproj" />
    <ProjectReference Include="..\..\Enrollments\Insurance.Enrollments.Contracts\Insurance.Enrollments.Contracts.csproj" />
    <ProjectReference Include="..\..\Billing\Insurance.Billing.Contracts\Insurance.Billing.Contracts.csproj" />
    <ProjectReference Include="..\..\Claims\Insurance.Claims.Contracts\Insurance.Claims.Contracts.csproj" />
  </ItemGroup>

</Project>
