<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- The Enrollments microservice: its own process, its own database (InsuranceEnrollments).
       It may reference BuildingBlocks and other services' *.Contracts projects, never their implementation. -->

  <PropertyGroup>
    <UserSecretsId>insurance-enrollments-service</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- Run by DatabaseMigrator at startup. -->
    <EmbeddedResource Include="Database\*.sql" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\BuildingBlocks\Insurance.BuildingBlocks\Insurance.BuildingBlocks.csproj" />
    <ProjectReference Include="..\Insurance.Enrollments.Contracts\Insurance.Enrollments.Contracts.csproj" />
    <ProjectReference Include="..\..\Catalog\Insurance.Catalog.Contracts\Insurance.Catalog.Contracts.csproj" />
    <ProjectReference Include="..\..\Quotes\Insurance.Quotes.Contracts\Insurance.Quotes.Contracts.csproj" />
    <ProjectReference Include="..\..\Billing\Insurance.Billing.Contracts\Insurance.Billing.Contracts.csproj" />
    <ProjectReference Include="..\..\Identity\Insurance.Identity.Contracts\Insurance.Identity.Contracts.csproj" />
  </ItemGroup>

</Project>
