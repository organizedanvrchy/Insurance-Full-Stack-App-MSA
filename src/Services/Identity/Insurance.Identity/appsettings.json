{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Database": "Server=localhost,1433;Database=InsuranceIdentity;User Id=sa;Password=<set in user secrets or ConnectionStrings__Database>;TrustServerCertificate=True;"
  },
  "Jwt": {
    "Issuer": "InsuranceApi",
    "Audience": "InsuranceApp",
    "ExpiryMinutes": 60
  },
  "RabbitMq": {
    "Host": "localhost",
    "Username": "guest",
    "Password": "guest"
  },
  "EmailVerification": {
    "LinkLifetime": "00:15:00",
    "ResendCooldown": "00:01:00",
    "MaxEmailsPerDay": 10
  }
}
