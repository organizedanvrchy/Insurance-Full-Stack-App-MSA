# Copy to deploy/.env and change both values. docker compose reads this file automatically.
# SQL Server requires 8+ characters with upper and lower case, a digit and a symbol.
SA_PASSWORD=Change_Me_123!
# Signs and checks every JWT. At least 32 random characters, the same for every service.
JWT_KEY=change-me-to-at-least-32-random-characters

# Email (optional). Without these, every email goes to Mailpit: open http://localhost:8025 to read them.
# For a real SMTP server (SendGrid, Azure Communication Services, Gmail with an app password...):
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_SECURITY=StartTls
# EMAIL_USERNAME=
# EMAIL_PASSWORD=
# EMAIL_FROM=no-reply@your-domain.com
# Where the Angular app runs; links in emails point here.
# APP_BASE_URL=http://localhost:4200

# Where customers can get help: every email says it's automated and points here. Optional.
# SUPPORT_EMAIL=support@your-domain.com

# The insurer's time zone (an IANA id): what "today" means for due dates and overdue premiums, and the zone
# emails show times in. Optional; the default is US Eastern (EST/EDT).
# BUSINESS_TIME_ZONE=America/New_York
